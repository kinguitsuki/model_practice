# ── Anthropic Claude API ──────────────────────────────────────────────────
# https://console.anthropic.com/ でAPIキーを取得してください
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── モデル設定 ────────────────────────────────────────────────────────────
# 利用可能なモデル: claude-sonnet-4-6, claude-haiku-4-5-20251001, claude-opus-4-7
CLAUDE_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096

# ── RAG 設定 ──────────────────────────────────────────────────────────────
# 埋め込みモデル (Hugging Face モデルID)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# チャンクサイズ（文字数）
CHUNK_SIZE=512

# チャンクオーバーラップ（文字数）
CHUNK_OVERLAP=64

# 検索時に返す上位k件
TOP_K=5

# ── ベクトルストア ────────────────────────────────────────────────────────
VECTOR_STORE_PATH=vector_store

# ── エージェント設定 ──────────────────────────────────────────────────────
# ReAct ループの最大反復回数
MAX_ITERATIONS=10

# 会話メモリのウィンドウサイズ（ターン数）
MEMORY_WINDOW=10
